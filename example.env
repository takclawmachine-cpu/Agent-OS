# Copy to .env.local for local development.
# This file contains placeholders only. Never commit real credentials.

# Use `real` for the companion WebSocket/polling service or `mock` for an offline demo.
NEXT_PUBLIC_REALTIME_MODE=real

# Use ws:// for local development and wss:// behind TLS.
NEXT_PUBLIC_HERMES_WS_URL=ws://127.0.0.1:8787/ws
NEXT_PUBLIC_HERMES_HTTP_URL=http://127.0.0.1:8787
NEXT_PUBLIC_HERMES_PROJECT_ID=agent-os

# Reconnect and transparent polling-fallback cadence.
NEXT_PUBLIC_HERMES_RECONNECT_MS=5000
NEXT_PUBLIC_HERMES_POLL_INTERVAL_MS=7000

# Server-only placeholder. Do not prefix secrets with NEXT_PUBLIC_.
HERMES_AUTH_TOKEN=
HERMES_WS_PORT=8787
HERMES_PUSH_INTERVAL_MS=5000
HERMES_CLI_ENABLED=false
HERMES_CLI_PATH=hermes
HERMES_CLI_TIMEOUT_MS=120000

# At least 32 random characters. Used only by the server to sign sessions.
AGENT_OS_SESSION_SECRET=

# Durable local storage and infrastructure-level backup location.
AGENT_OS_ENVIRONMENT=Local
AGENT_OS_DATABASE_PATH=./data/agent-os.db
AGENT_OS_BACKUP_PATH=./backups

# Optional deployed target for `npm run smoke`. Defaults to the local web server.
STAGING_URL=

# Model providers. Configure only the providers used by this deployment.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
CHAT_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# GitHub API and signed webhook receiver.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# SMTP credentials remain server-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
