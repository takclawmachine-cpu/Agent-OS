# Copy this file to .env.local for local use, or pass it to Docker with
# `docker run --env-file .env.local`. Never commit real credentials.

# REQUIRED CORE SETTINGS
# Run `npm run setup` to generate the password hash and session secret safely.
AGENT_OS_OWNER_NAME=
AGENT_OS_OWNER_EMAIL=
AGENT_OS_OWNER_PASSWORD_HASH=
AGENT_OS_SESSION_SECRET=
AGENT_OS_ENVIRONMENT=Local
AGENT_OS_DATABASE_PATH=./data/agent-os.db
AGENT_OS_BACKUP_PATH=./backups

# REQUIRED AI CONNECTION: configure at least one option in this section.
# Local Hermes can be used instead of a hosted provider key.
HERMES_CLI_ENABLED=false
HERMES_CLI_PATH=hermes
HERMES_CLI_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# OPTIONAL REALTIME CONNECTION
NEXT_PUBLIC_REALTIME_MODE=websocket

# Use ws:// for local development and wss:// behind TLS.
NEXT_PUBLIC_HERMES_WS_URL=ws://127.0.0.1:8787/ws
NEXT_PUBLIC_HERMES_HTTP_URL=http://127.0.0.1:8787

# Reconnect and transparent polling-fallback cadence.
NEXT_PUBLIC_HERMES_RECONNECT_MS=5000
NEXT_PUBLIC_HERMES_POLL_INTERVAL_MS=7000

# Server-only realtime settings. Do not prefix secrets with NEXT_PUBLIC_.
HERMES_AUTH_TOKEN=
HERMES_WS_PORT=8787
HERMES_PUSH_INTERVAL_MS=5000

# Optional deployed target for `npm run smoke`. Defaults to the local web server.
STAGING_URL=

# OPTIONAL MODEL SETTINGS
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
XAI_BASE_URL=https://api.x.ai/v1
CHAT_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# OPTIONAL GITHUB API AND SIGNED WEBHOOK RECEIVER
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# OPTIONAL SMTP CONNECTION
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
