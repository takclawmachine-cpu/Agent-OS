{
  "name": "agent-os-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "config:check": "node scripts/setup-env.mjs --check",
    "dev": "next dev",
    "dev:full": "concurrently --kill-others --names web,realtime,scheduler \"npm:dev -- --hostname 127.0.0.1 --port 3000\" \"npm:realtime\" \"npm:scheduler\"",
    "build": "next build",
    "start": "next start",
    "start:full": "concurrently --kill-others --names web,realtime,scheduler \"npm:start\" \"npm:realtime\" \"npm:scheduler\"",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:hermes": "node scripts/smoke.mjs --hermes",
    "security:hooks": "node scripts/install-git-hooks.mjs",
    "security:secrets": "node scripts/check-staged-secrets.mjs",
    "security:dependencies": "npm audit --audit-level=high",
    "prepare": "node scripts/install-git-hooks.mjs",
    "realtime": "node server/realtime.mjs",
    "scheduler": "node server/scheduler.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
